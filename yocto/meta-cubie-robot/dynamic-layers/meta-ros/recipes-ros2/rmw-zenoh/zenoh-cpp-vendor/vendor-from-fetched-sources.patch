zenoh_cpp_vendor: build zenoh-c and zenoh-cpp from sources fetched by bitbake

ament_vendor clones both repos with vcs import during the build, which bitbake
can't mirror, checksum or run offline. The recipe fetches the same commits
(SRCREV_zenoh-c, SRCREV_zenoh-cpp) and passes their paths in, ament_vendor's
path mode builds them in place. pin-rust-1.75.0.patch only edits
rust-toolchain.toml, which matters to rustup, not to yocto's cargo.

Upstream-Status: Inappropriate [yocto specific]

--- a/CMakeLists.txt	2026-11-12 03:06:49.745208926 +0100
+++ b/CMakeLists.txt	2026-11-12 03:06:49.755087785 +0100
@@ -43,20 +43,19 @@
 # * Precommit SHM pages, avoiding overcommit and possible crash if SHM exhausts
 #   - https://github.com/eclipse-zenoh/zenoh/pull/2175
 ament_vendor(zenoh_c_vendor
-  VCS_URL https://github.com/eclipse-zenoh/zenoh-c.git
-  VCS_VERSION f376456ccf75ed837a21a186bdf5191cba50eb3b
+  VCS_TYPE path
+  VCS_URL ${ZENOH_C_SOURCE_DIR}
   CMAKE_ARGS
     "-DZENOHC_CARGO_FLAGS=${ZENOHC_CARGO_FLAGS}"
     "-DZENOHC_BUILD_WITH_UNSTABLE_API=TRUE"
     "-DZENOHC_CUSTOM_TARGET=${ZENOHC_CUSTOM_TARGET}"
-  PATCHES ${CMAKE_CURRENT_SOURCE_DIR}/pin-rust-1.75.0.patch
 )
 
 ament_export_dependencies(zenohc)
 
 ament_vendor(zenoh_cpp_vendor
-  VCS_URL https://github.com/eclipse-zenoh/zenoh-cpp
-  VCS_VERSION 0cd54f291039a65b96921a5951a66aeef088e67c
+  VCS_TYPE path
+  VCS_URL ${ZENOH_CPP_SOURCE_DIR}
   CMAKE_ARGS
     -DZENOHCXX_ZENOHC=OFF
 )
