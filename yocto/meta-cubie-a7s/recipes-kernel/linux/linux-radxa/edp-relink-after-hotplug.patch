+/*
+ * Commit a full modeset on the active display pipe, which runs the encoder
+ * enable path and with it link training. Returns 0 when it committed, 1 when
+ * there's nothing to retrain (no drm device yet, pipe off), or an error.
+ */
+static int edp_relink_active_pipe(struct sunxi_drm_edp *drm_edp)
+{
+	struct drm_connector *connector = &drm_edp->sdrm.connector;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_atomic_state *state;
+	int ret;
+
+	if (!connector->dev || !connector->dev->registered)
+		return 1;
+
+	state = drm_atomic_state_alloc(connector->dev);
+	if (!state)
+		return -ENOMEM;
+
+	drm_modeset_acquire_init(&ctx, 0);
+	state->acquire_ctx = &ctx;
+retry:
+	conn_state = drm_atomic_get_connector_state(state, connector);
+	if (IS_ERR(conn_state)) {
+		ret = PTR_ERR(conn_state);
+		goto out;
+	}
+
+	ret = 1;
+	if (!conn_state->crtc)
+		goto out;
+
+	crtc_state = drm_atomic_get_crtc_state(state, conn_state->crtc);
+	if (IS_ERR(crtc_state)) {
+		ret = PTR_ERR(crtc_state);
+		goto out;
+	}
+
+	if (!crtc_state->active)
+		goto out;
+
+	crtc_state->connectors_changed = true;
+	ret = drm_atomic_commit(state);
+out:
+	if (ret == -EDEADLK) {
+		drm_atomic_state_clear(state);
+		drm_modeset_backoff(&ctx);
+		goto retry;
+	}
+	if (ret < 0)
+		EDP_WRN("relink commit failed: %d\n", ret);
+
+	drm_atomic_state_put(state);
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+	return ret;
+}
+
+/*
+ * Unplugging stops the main link and plugging back in only rereads the dpcd
+ * and edid, so an active pipe (a console, no compositor) stays black: nobody
+ * asks for a modeset. Link training can also fail on a sink that isn't ready
+ * yet, some typec docks need a moment after hpd before hbr2 aligns.
+ * So 1s after a plugin, or 2s after a failed enable, retrain the active pipe
+ * unless something already brought the output up, 5 tries per plug at most.
+ */
+#define EDP_RELINK_MAX_TRIES	5
+
+static void edp_relink_check(struct sunxi_drm_edp *drm_edp)
+{
+	int ret;
+
+	if (!drm_edp->hpd_state || !READ_ONCE(drm_edp->relink_pending))
+		return;
+	if (time_before(jiffies, READ_ONCE(drm_edp->relink_at)))
+		return;
+
+	if (drm_edp->relink_tries >= EDP_RELINK_MAX_TRIES) {
+		WRITE_ONCE(drm_edp->relink_pending, false);
+		EDP_WRN("link still down after %d relinks, giving up\n",
+			drm_edp->relink_tries);
+		return;
+	}
+
+	drm_edp->relink_tries++;
+	WRITE_ONCE(drm_edp->relink_at, jiffies + 2 * HZ);
+
+	ret = edp_relink_active_pipe(drm_edp);
+	/* pipe off: whoever turns it on trains the link */
+	if (ret > 0)
+		WRITE_ONCE(drm_edp->relink_pending, false);
+}
+
