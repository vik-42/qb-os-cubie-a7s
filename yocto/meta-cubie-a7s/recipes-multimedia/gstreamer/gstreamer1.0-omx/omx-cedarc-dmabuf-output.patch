+/* every plane of a cedarc frame lives in one dmabuf and each map syncs all of
+ * it, so map it once per frame and hand the planes pointers into that */
+typedef struct
+{
+  GMutex lock;
+  guint count;
+  GstMapInfo map;
+} GstOMXCedarcFrameMap;
+
+static GQuark cedarc_frame_map_quark;
+
+static void
+cedarc_frame_map_free (gpointer data)
+{
+  GstOMXCedarcFrameMap *fmap = data;
+
+  g_mutex_clear (&fmap->lock);
+  g_free (fmap);
+}
+
+static gboolean
+cedarc_frame_meta_map (GstVideoMeta * meta, guint plane, GstMapInfo * info,
+    gpointer * data, gint * stride, GstMapFlags flags)
+{
+  GstOMXCedarcFrameMap *fmap = gst_mini_object_get_qdata (GST_MINI_OBJECT
+      (meta->buffer), cedarc_frame_map_quark);
+  gboolean shared = FALSE;
+
+  if (fmap) {
+    g_mutex_lock (&fmap->lock);
+    if (fmap->count == 0 && gst_buffer_map (meta->buffer, &fmap->map, flags))
+      shared = TRUE;
+    else if (fmap->count > 0
+        && !((flags & ~fmap->map.flags) & GST_MAP_READWRITE))
+      shared = TRUE;
+    if (shared) {
+      fmap->count++;
+      *info = fmap->map;
+      info->user_data[0] = fmap;
+    }
+    g_mutex_unlock (&fmap->lock);
+  }
+
+  /* a copied buffer or a wider map than the one in use, map on its own */
+  if (!shared) {
+    if (!gst_buffer_map (meta->buffer, info, flags))
+      return FALSE;
+    info->user_data[0] = NULL;
+  }
+
+  *data = (guint8 *) info->data + meta->offset[plane];
+  *stride = meta->stride[plane];
+  return TRUE;
+}
+
+static gboolean
+cedarc_frame_meta_unmap (GstVideoMeta * meta, guint plane, GstMapInfo * info)
+{
+  GstOMXCedarcFrameMap *fmap = info->user_data[0];
+
+  if (!fmap) {
+    gst_buffer_unmap (meta->buffer, info);
+    return TRUE;
+  }
+
+  g_mutex_lock (&fmap->lock);
+  if (--fmap->count == 0)
+    gst_buffer_unmap (meta->buffer, &fmap->map);
+  g_mutex_unlock (&fmap->lock);
+  return TRUE;
+}
