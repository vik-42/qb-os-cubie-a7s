+      port->port_def.eDir == OMX_DirOutput &&
+      !g_getenv ("NONE_ZERO_COPY_MODE") && !g_getenv ("RAW_ZERO_COPY_MODE") &&
+      !g_getenv ("META_RAW_ZERO_COPY_MODE");
+}
