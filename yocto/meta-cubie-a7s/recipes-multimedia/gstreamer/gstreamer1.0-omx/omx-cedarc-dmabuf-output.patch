  */
 #define GST_OMX_HACK_ENSURE_BUFFER_COUNT_ACTUAL          G_GUINT64_CONSTANT (0x0000000000002000)
 
+/* Allwinner CedarC: the decoders allocate their own frames and every output
+ * buffer is a descriptor (GstOMXCedarcFrame) pointing at one of them. Export
+ * the frame's dmabuf downstream instead of the descriptor. Only in CedarC's
+ * default buffer mode, the *_ZERO_COPY_MODE environment variables pick others.
+ */
+#define GST_OMX_HACK_CEDARC_DMABUF_OUTPUT                G_GUINT64_CONSTANT (0x0000000000004000)
+
+/* CedarC's output buffer descriptor (OmxPrivateBuffer) */
+typedef struct {
+  guint64 id;
+  guint32 flags;
+  guint8 *phy_y;
+  guint8 *phy_c;
+  guint8 *vir_y;
+  guint8 *vir_c;
+  gint32 crop;
+  gint32 left;
+  gint32 top;
+  gint32 width;
+  gint32 height;
+  gint32 dmabuf_fd;
+  gint32 size;
+  gpointer client_data;
+} GstOMXCedarcFrame;
+
+G_STATIC_ASSERT (sizeof (GstOMXCedarcFrame) == 88);
+G_STATIC_ASSERT (G_STRUCT_OFFSET (GstOMXCedarcFrame, dmabuf_fd) == 68);
+
